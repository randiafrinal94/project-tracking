# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker_dev_password
POSTGRES_DB=project_tracker
POSTGRES_PORT=5432

# Connection string dipakai oleh packages/db, apps/api, dan seeder
DATABASE_URL=postgres://tracker:tracker_dev_password@localhost:5432/project_tracker

# Adminer (opsional, profile "tools")
ADMINER_PORT=8080

# Password untuk semua user seed (khusus development)
SEED_USER_PASSWORD=Password123!

# --- API (apps/api) ---
API_PORT=4000
# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
WEB_ORIGIN=http://localhost:3000
# Minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Batas login/register per IP per menit
AUTH_RATE_LIMIT_PER_MINUTE=10

# Lampiran disk lokal (relatif ke root repo) & batas ukuran per file
STORAGE_DIR=storage/uploads
MAX_UPLOAD_MB=10
